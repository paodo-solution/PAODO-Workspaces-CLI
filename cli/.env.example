# Copy to .env beside this file, then fill both in.
#
# PAODO_ENDPOINT — the programmatic base URL of your PAODO app, no trailing slash, no query or
#                  fragment, and no credentials in the URL.
# PAODO_TOKEN    — the CLI token for that app.
#
# Both are read from this directory regardless of where you run `paodo` from. Exported variables of
# the same name take precedence over whatever is written here.

PAODO_ENDPOINT=
PAODO_TOKEN=
